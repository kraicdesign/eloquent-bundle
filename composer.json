{
    "name": "kraicdesign/eloquent-bundle",
    "description": "Symfony bundle that wires Laravel's Eloquent (Illuminate Database) into the Symfony container, with database:migrate and database:migrate:rollback console commands.",
    "type": "symfony-bundle",
    "keywords": ["symfony", "bundle", "eloquent", "illuminate", "database", "migrations"],
    "license": "MIT",
    "authors": [
        {
            "name": "Kraic Design",
            "homepage": "https://github.com/kraicdesign"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kraicdesign\\EloquentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kraicdesign\\EloquentBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
